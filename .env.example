# Google Gemini API-Key (aus Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=dein-gemini-api-key-hier

# Smart-Routing Modelle (jederzeit anpassbar, auch live im Eltern-Dashboard)
GEMINI_MODEL_FAST=gemini-3.8-flash
GEMINI_MODEL_SMART=gemini-4-hydrogen

# Zugriffsschutz (unbedingt vor Online-Hosting ändern!)
FAMILY_PASSWORD=familie2026
PARENT_PIN=1234

# Optional: eigenes Session-Secret (sonst automatisch in data/.session_secret erzeugt)
# SESSION_SECRET=

# Bei Betrieb hinter HTTPS (z.B. Reverse Proxy / Cloudflare Tunnel / Tailscale HTTPS) auf true setzen
COOKIE_SECURE=false

# Port der Web-App
PORT=8000
